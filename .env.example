# Copiá este archivo como .env.local y completá los valores. No subas .env.local al repo.

# Cuenta de Gmail que envía y recibe los formularios de contacto y del sorteo
EMAIL=tu-cuenta@gmail.com

# Contraseña de aplicación de Google (no la contraseña de la cuenta):
# https://myaccount.google.com/apppasswords
EMAIL_PASS=xxxx xxxx xxxx xxxx
